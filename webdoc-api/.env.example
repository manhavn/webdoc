# Optional environment fallback. CLI flags override these values and are
# written into generated autostart configuration.
# Demo content is opt-in; default installs start with no articles/partners.
# WEBDOC_SEED=false

# Server
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=webdoc
WEBDOC_HOST=127.0.0.1
PORT=18620

# Public URL prefixes (same domain deployment)
API_PREFIX=/api
ADMIN_PREFIX=/admin

# Auth (change the secret and password outside local development)
JWT_SECRET=dev-secret-change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Uploads (resolved independently of the current directory)
# 1. UPLOAD_DIR (highest priority)
# 2. WEBDOC_DATA_DIR/uploads
# 3. <package root>/data/uploads when the extracted package has a data dir
# 4. $XDG_DATA_HOME/webdoc/uploads (or ~/.local/share/webdoc/uploads)
# UPLOAD_DIR=./uploads
# WEBDOC_DATA_DIR=/var/lib/webdoc

# Extra allowed origins, comma separated (defaults include localhost/127.0.0.1:5173-5174)
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Optional development overrides. Release binaries serve the embedded UI/CMS
# builds; point these at `dist` folders to iterate without rebuilding Rust.
# UI_DIST=../webdoc-ui/dist
# ADMIN_DIST=../webdoc-admin/dist

# Public UI response cache (successful JSON GETs only; one file per query)
# WEBDOC_CACHE_DIR=/tmp/webdoc
# WEBDOC_CACHE_TTL_SECS=120
